# Переменные для docker compose (продакшн-деплой).
# Скопируйте в .env и заполните: cp .env.example .env

# Секрет для JWT-токенов авторизации. Сгенерируйте: openssl rand -hex 32
JWT_SECRET=смените-на-длинную-случайную-строку

# Пароль пользователя БД. Смените на надёжный для продакшна.
POSTGRES_PASSWORD=смените-на-надёжный-пароль

# Токен Telegram-бота от @BotFather (для напоминаний). Можно оставить пустым.
TELEGRAM_BOT_TOKEN=

# Часовой пояс для напоминаний
APP_TIMEZONE=Europe/Moscow

# Домен для HTTPS (Caddy сам получит сертификат Let's Encrypt).
#   свой домен:      planner.example.com
#   без домена:      <IP-сервера-через-дефисы>.nip.io  (напр. 203-0-113-5.nip.io)
#   только HTTP:     :80   (без сертификата, PWA не установится)
APP_DOMAIN=:80
